{
  "name": "playwright-bbd-framework",
  "version": "1.0.0",
  "private": true,
  "description": "A beginner-friendly Playwright and Cucumber.js framework for AutomationExercise.",
  "type": "module",
  "scripts": {
    "test": "npm run test:cucumber",
    "test:utilities": "node --test tests/common-utils.test.js tests/test-data.test.js tests/config-artifacts.test.js",
    "test:cucumber": "cross-env CUCUMBER_RETRIES=0 cucumber-js --config cucumber.config.js",
    "test:cucumber:retry": "cross-env CUCUMBER_RETRIES=2 cucumber-js --config cucumber.config.js",
    "test:retry:demo": "cross-env CUCUMBER_RETRIES=2 cucumber-js --config cucumber.retry-demo.config.js",
    "test:chromium": "cross-env BROWSER=chromium cucumber-js --config cucumber.config.js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js --config cucumber.config.js",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js --config cucumber.config.js",
    "test:parallel": "cross-env CUCUMBER_WORKERS=3 cucumber-js --config cucumber.config.js",
    "test:parallel:demo": "cross-env CUCUMBER_WORKERS=2 cucumber-js --config cucumber.config.js --tags \"@parallel\"",
    "test:ui": "cucumber-js --config cucumber.config.js --tags \"@ui\"",
    "test:api": "cucumber-js --config cucumber.config.js --tags \"@api\"",
    "test:integration": "cucumber-js --config cucumber.config.js --tags \"@integration\"",
    "test:headed": "cross-env HEADLESS=false cucumber-js --config cucumber.config.js",
    "test:debug": "cross-env DEBUG=pw:api cucumber-js --config cucumber.config.js",
    "report:cucumber": "npm run test:cucumber",
    "report:allure:results": "npm run test:cucumber",
    "report:allure": "allure generate allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "config:validate": "node -e \"import('./config/config.js').then(({ default: config }) => console.log(JSON.stringify(config, null, 2)))\"",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "playwright:install": "playwright install chromium",
    "playwright:install:all": "playwright install chromium firefox webkit"
    "allure:share": "allure generate allure-results --clean --single-file --name \"Team Allure Report\" -o reports/allure-share && node scripts/package-allure-report.js",
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@cucumber/html-formatter": "^24.1.1",
    "@eslint/js": "^10.0.1",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.12.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "winston": "^3.19.0"
  }
}
